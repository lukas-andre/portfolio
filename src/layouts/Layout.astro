---
import BootScreen from '../components/ui/BootScreen.tsx';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description?: string;
  showBoot?: boolean;
  lang?: 'es' | 'en';
  canonicalPath?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  alternateLanguages?: Array<{ lang: 'es' | 'en'; href: string }>;
  jsonLd?: Record<string, unknown>;
  robots?: string;
}

const {
  title,
  description = "Tech Lead & Software Engineer specializing in TypeScript, Go, and AI-native development. Building exceptional digital experiences at Falabella.",
  showBoot = true,
  lang = 'en',
  canonicalPath = '/',
  ogType = 'website',
  ogImage = '/og.png',
  alternateLanguages = [],
  robots = 'index, follow',
  jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Lucas Andre Henry Diaz',
    jobTitle: 'Tech Lead',
    url: 'https://lucashenry.dev',
    image: 'https://lucashenry.dev/images/profile.jpeg',
    sameAs: [
      'https://linkedin.com/in/lucas-henryd',
      'https://github.com/lukas-andre',
    ],
    worksFor: { '@type': 'Organization', name: 'Falabella' },
    knowsAbout: ['TypeScript', 'Go', 'React', 'AI', 'Microfrontends', 'E-commerce'],
  },
} = Astro.props;

const site = Astro.site ?? new URL('https://lucashenry.dev');
const canonicalUrl = new URL(canonicalPath, site).toString();
const ogImageUrl = new URL(ogImage, site).toString();
---

<!DOCTYPE html>
<html lang={lang} data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#f3f0e8" />
  <script is:inline>
    (() => {
      let theme = 'light';
      try {
        if (window.localStorage.getItem('lucas-color-theme') === 'dark') theme = 'dark';
      } catch { /* Light remains the deterministic default. */ }
      document.documentElement.dataset.theme = theme;
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#0d0d0b' : '#f3f0e8');
    })();
  </script>
  <meta name="description" content={description} />
  <meta name="author" content="Lucas Andre Henry Diaz" />
  <meta name="keywords" content="Tech Lead, Software Engineer, TypeScript, Go, React, AI, Santiago Chile, Falabella, Microfrontends" />
  <meta name="robots" content={robots} />
  <meta name="googlebot" content={robots} />
  <!-- Canonical -->
  <link rel="canonical" href={canonicalUrl} />
  {alternateLanguages.map((alternate) => (
    <link rel="alternate" hreflang={alternate.lang} href={new URL(alternate.href, site).toString()} />
  ))}
  {alternateLanguages.length > 0 && (
    <link rel="alternate" hreflang="x-default" href={new URL(alternateLanguages[0].href, site).toString()} />
  )}

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/favicon.png" />

  <!-- Performance hints -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="dns-prefetch" href="https://fonts.googleapis.com" />

  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <title>{title}</title>
</head>
<body>
  <!-- Boot Screen -->
  {showBoot && (
    <div id="boot-container">
      <BootScreen client:load />
    </div>
  )}

  <!-- Subtle Scanlines Overlay -->
  <div class="scanlines"></div>

  <!-- Noise Texture Overlay -->
  <div class="noise"></div>

  <!-- Scroll Progress Bar -->
  <div class="scroll-progress">
    <div class="scroll-progress-bar" id="scroll-bar"></div>
  </div>

  <ThemeToggle lang={lang} />

  <!-- Main Content -->
  <div id="main-content" class:list={['main-content', { loaded: !showBoot }]}>
    <slot />
  </div>

  <!-- Scroll Progress Script -->
  <script>
    const scrollBar = document.getElementById('scroll-bar');

    function updateScrollProgress() {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const scrollPercent = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
      if (scrollBar) {
        scrollBar.style.width = `${scrollPercent}%`;
      }
    }

    window.addEventListener('scroll', updateScrollProgress, { passive: true });
    updateScrollProgress();

    // Fallback: ensure content shows after max 5 seconds even if boot fails
    setTimeout(() => {
      const mainContent = document.getElementById('main-content');
      const bootContainer = document.getElementById('boot-container');
      if (mainContent && !mainContent.classList.contains('loaded')) {
        mainContent.classList.add('loaded');
        if (bootContainer) {
          bootContainer.style.display = 'none';
        }
      }
    }, 5000);
  </script>
</body>
</html>

<style is:global>
  @import '../styles/global.css';

  /* Main content fade in */
  .main-content {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }

  .main-content.loaded {
    opacity: 1;
    transform: translateY(0);
  }
</style>
