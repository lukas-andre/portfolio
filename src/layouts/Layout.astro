---
import BootScreen from '../components/ui/BootScreen.tsx';
import ThemeToggle from '../components/ThemeToggle.astro';
import { profile } from '../data/profile';
import { personSchema, serializeJsonLd, websiteSchema } from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  showBoot?: boolean;
  lang?: 'es' | 'en';
  canonicalPath?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  ogImageAlt?: string;
  alternateLanguages?: Array<{ lang: 'es' | 'en'; href: string }>;
  jsonLd?: Record<string, unknown>;
  robots?: string;
  markdownPath?: string;
  describedByPath?: string;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleAuthorUrl?: string;
}

const {
  title,
  description = profile.seoDescription,
  showBoot = false,
  lang = 'en',
  canonicalPath = '/',
  ogType = 'website',
  ogImage = '/open-graph/v4/home.png',
  ogImageAlt = 'Lucas Henry — Tech Team Lead for Customer and Seller Self Service, and builder of agentic systems.',
  alternateLanguages = [],
  robots = 'index, follow',
  jsonLd,
  markdownPath,
  describedByPath = '/llms.txt',
  articlePublishedTime,
  articleModifiedTime,
  articleAuthorUrl,
} = Astro.props;

const site = Astro.site ?? new URL('https://lucashenry.dev');
const canonicalUrl = new URL(canonicalPath, site).toString();
const ogImageUrl = new URL(ogImage, site).toString();
const locales = { es: 'es_CL', en: 'en_US' } as const;
const structuredData = jsonLd ?? {
  '@context': 'https://schema.org',
  '@type': canonicalPath === '/' ? 'ProfilePage' : 'WebPage',
  '@id': `${canonicalUrl}#webpage`,
  url: canonicalUrl,
  name: title,
  description,
  inLanguage: lang,
  mainEntity: personSchema(site),
  isPartOf: websiteSchema(site),
};
---

<!DOCTYPE html>
<html lang={lang} data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#f3f0e8" />
  <script is:inline>
    (() => {
      let theme = 'light';
      try {
        if (window.localStorage.getItem('lucas-color-theme') === 'dark') theme = 'dark';
      } catch { /* Light remains the deterministic default. */ }
      document.documentElement.dataset.theme = theme;
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#0d0d0b' : '#f3f0e8');
    })();
  </script>
  <meta name="description" content={description} />
  <meta name="author" content="Lucas Andre Henry Diaz" />
  <meta name="robots" content={robots} />
  <meta name="googlebot" content={robots} />
  <!-- Canonical -->
  <link rel="canonical" href={canonicalUrl} />
  {alternateLanguages.map((alternate) => (
    <link rel="alternate" hreflang={alternate.lang} href={new URL(alternate.href, site).toString()} />
  ))}
  {alternateLanguages.length > 0 && (
    <link rel="alternate" hreflang="x-default" href={new URL(alternateLanguages[0].href, site).toString()} />
  )}
  {markdownPath && <link rel="alternate" type="text/markdown" href={new URL(markdownPath, site).toString()} />}
  {describedByPath && <link rel="describedby" href={new URL(describedByPath, site).toString()} />}
  <link
    rel="alternate"
    type="application/rss+xml"
    title={lang === 'es' ? 'Notas de Lucas Henry' : 'Lucas Henry’s Notes'}
    href={new URL(lang === 'es' ? '/es/notas/feed.xml' : '/en/notes/feed.xml', site).toString()}
  />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={profile.name} />
  <meta property="og:locale" content={locales[lang]} />
  {alternateLanguages.filter((alternate) => alternate.lang !== lang).map((alternate) => (
    <meta property="og:locale:alternate" content={locales[alternate.lang]} />
  ))}
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:alt" content={ogImageAlt} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  {ogType === 'article' && articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
  {ogType === 'article' && articleModifiedTime && <meta property="article:modified_time" content={articleModifiedTime} />}
  {ogType === 'article' && articleAuthorUrl && <meta property="article:author" content={articleAuthorUrl} />}

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <meta name="twitter:image:alt" content={ogImageAlt} />

  <link rel="preload" href="/fonts/space-grotesk-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/jetbrains-mono-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
  {canonicalPath !== '/' && <link rel="preload" href="/fonts/newsreader-latin-standard-normal.woff2" as="font" type="font/woff2" crossorigin />}

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/favicon.png" />

  <script is:inline type="application/ld+json" set:html={serializeJsonLd(structuredData)} />

  <title>{title}</title>
</head>
<body>
  <!-- Boot Screen -->
  {showBoot && (
    <div id="boot-container">
      <BootScreen client:load />
    </div>
  )}

  <!-- Subtle Scanlines Overlay -->
  <div class="scanlines"></div>

  <!-- Noise Texture Overlay -->
  <div class="noise"></div>

  <!-- Scroll Progress Bar -->
  <div class="scroll-progress">
    <div class="scroll-progress-bar" id="scroll-bar"></div>
  </div>

  <ThemeToggle lang={lang} />

  <!-- Main Content -->
  <div id="main-content" class:list={['main-content', { loaded: !showBoot }]}>
    <slot />
  </div>

  <!-- Scroll Progress Script -->
  <script>
    const scrollBar = document.getElementById('scroll-bar');

    function updateScrollProgress() {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const scrollPercent = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
      if (scrollBar) {
        scrollBar.style.width = `${scrollPercent}%`;
      }
    }

    window.addEventListener('scroll', updateScrollProgress, { passive: true });
    updateScrollProgress();

    // Fallback: ensure content shows after max 5 seconds even if boot fails
    setTimeout(() => {
      const mainContent = document.getElementById('main-content');
      const bootContainer = document.getElementById('boot-container');
      if (mainContent && !mainContent.classList.contains('loaded')) {
        mainContent.classList.add('loaded');
        if (bootContainer) {
          bootContainer.style.display = 'none';
        }
      }
    }, 5000);
  </script>
</body>
</html>

<style is:global>
  @import '../styles/global.css';

  /* Server-rendered content stays visible even when JavaScript is unavailable. */
  .main-content {
    opacity: 1;
    transform: none;
    transition: opacity 0.8s ease, transform 0.8s ease;
  }

  .main-content.loaded {
    opacity: 1;
    transform: translateY(0);
  }
</style>
