---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Skills from '../components/Skills.astro';
import Experience from '../components/Experience.astro';
import Demos from '../components/Demos.astro';
import AISection from '../components/AISection.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import NeuralCanvas from '../components/ui/NeuralCanvas';
import { getTranslation, getVisibleNotes } from '../lib/notes';
import { profile } from '../data/profile';

const publishedNotes = (await getVisibleNotes('en')).filter((note) => !note.data.draft);
const [latestNote] = publishedNotes;
const latestTranslation = latestNote ? await getTranslation(latestNote) : undefined;
---

<Layout
  title="Lucas Henry | Tech Team Lead & Agentic Systems"
  description={profile.summary}
  showBoot={false}
>
  <!-- Neural Network Background -->
  <NeuralCanvas client:load />

  <!-- Navigation -->
  <Navigation />

  <!-- Main Content -->
  <main>
    <Hero
      latestNote={latestNote}
      latestTranslation={latestTranslation}
      latestNoteNumber={publishedNotes.length}
    />
    <About />
    <Skills />
    <Experience />
    <Demos />
    <AISection />
    <Contact />
  </main>

  <!-- Footer -->
  <Footer />
</Layout>

<style is:global>
  /* Smooth scroll behavior */
  html {
    scroll-behavior: smooth;
  }

  /* Page transitions */
  main {
    animation: fadeIn 1s ease;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* Ensure sections stack correctly */
  main > section {
    position: relative;
    z-index: 1;
  }
</style>
