---
import CinematicReveal from './ui/CinematicReveal.astro';
import { profile } from '../data/profile';
---

<section id="experience" class="section experience">
  <CinematicReveal>
    <header class="section-header">
      <span class="section-cmd">git log --graph --career</span>
      <h2 class="section-title"><span>[</span> Runtime History <span>]</span></h2>
      <p class="section-intro">From hands-on commerce engineering to leading the full self-service portfolio.</p>
    </header>
  </CinematicReveal>

  <CinematicReveal delay={0.1}>
    <div class="scope-bar" aria-label="Current leadership scope">
      <span><b>HEAD</b> {profile.role}</span>
      <span><b>{profile.scope.capabilities}</b> capabilities</span>
      <span><b>{profile.scope.teams}</b> teams</span>
      <span><b>{profile.scope.people}</b> people</span>
    </div>
  </CinematicReveal>

  <div class="timeline">
    {profile.experiences.map((experience, index) => (
      <CinematicReveal delay={Math.min(0.12 * (index + 1), 0.65)}>
        <article class:list={['career-entry', { current: experience.current }]}>
          <div class="rail" aria-hidden="true">
            <span class="dot"></span>
            {index < profile.experiences.length - 1 && <span class="line"></span>}
          </div>

          <div class="entry-card">
            <div class="commit-line">
              <code>{experience.id}</code>
              <span>({experience.branch})</span>
              {experience.current && <strong>HEAD</strong>}
            </div>
            <div class="entry-heading">
              <div>
                <h3>{experience.role}</h3>
                <p class="company">@ {experience.company}</p>
              </div>
              <time>{experience.period}</time>
            </div>
            <p class="description">{experience.description}</p>
            <div class="diff" aria-label="Role highlights">
              <div class="diff-file">diff --git a/career.md b/career.md</div>
              {experience.highlights.map((highlight) => (
                <p><span>+</span>{highlight}</p>
              ))}
            </div>
            <ul class="tags" aria-label="Skills used">
              {experience.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          </div>
        </article>
      </CinematicReveal>
    ))}
  </div>
</section>

<style>
  .experience { background: linear-gradient(180deg, var(--bg-primary), var(--bg-secondary), var(--bg-primary)); }
  .section-header { margin-bottom: 2rem; }
  .section-cmd { display: block; margin-bottom: .5rem; color: var(--accent-sage); font: .8rem var(--font-terminal); }
  .section-title { display: flex; gap: .5rem; align-items: center; color: var(--text-primary); font-size: clamp(2rem, 5vw, 3rem); font-weight: 600; }
  .section-title span { color: var(--accent-amber); font-weight: 300; }
  .section-intro { max-width: 640px; margin-top: .75rem; color: var(--text-muted); }
  .scope-bar { display: flex; flex-wrap: wrap; gap: .55rem 1.25rem; margin-bottom: 2.5rem; padding: .9rem 1rem; border: 1px solid var(--glass-border); border-radius: var(--radius-md); background: var(--bg-tertiary); color: var(--text-muted); font: .74rem var(--font-terminal); }
  .scope-bar b { color: var(--accent-amber); font-weight: 600; }
  .timeline { max-width: 960px; margin: 0 auto; }
  .career-entry { display: grid; grid-template-columns: 34px minmax(0, 1fr); }
  .rail { position: relative; display: flex; justify-content: center; }
  .dot { position: relative; z-index: 1; width: 13px; height: 13px; margin-top: 1.45rem; border: 2px solid var(--accent-sage); border-radius: 50%; background: var(--bg-primary); }
  .line { position: absolute; top: 2rem; bottom: -1px; width: 1px; background: linear-gradient(var(--accent-sage), var(--glass-border)); }
  .career-entry.current .dot { border-color: var(--accent-amber); background: var(--accent-amber); box-shadow: 0 0 0 5px var(--glass-active); }
  .entry-card { min-width: 0; margin-bottom: 1.25rem; padding: 1.25rem; border: 1px solid var(--glass-border); border-radius: var(--radius-lg); background: color-mix(in srgb, var(--bg-card) 92%, transparent); box-shadow: var(--shadow-terminal); transition: transform var(--transition-medium), border-color var(--transition-medium); }
  .entry-card:hover { transform: translateY(-3px); border-color: var(--accent-amber); }
  .career-entry.current .entry-card { border-left: 3px solid var(--accent-amber); }
  .commit-line { display: flex; flex-wrap: wrap; gap: .55rem; margin-bottom: .8rem; color: var(--text-dim); font: .68rem var(--font-terminal); }
  .commit-line code { color: var(--accent-sage); }
  .commit-line strong { padding: .05rem .35rem; border-radius: 999px; background: var(--accent-amber); color: var(--text-on-accent); letter-spacing: .08em; }
  .entry-heading { display: flex; justify-content: space-between; gap: 1.25rem; align-items: flex-start; }
  h3 { color: var(--text-primary); font-size: clamp(1rem, 2.2vw, 1.3rem); line-height: 1.35; }
  .company { margin-top: .2rem; color: var(--accent-amber); font: .78rem var(--font-terminal); }
  time { flex: 0 0 auto; color: var(--text-muted); font: .7rem var(--font-terminal); }
  .description { max-width: 760px; margin: 1rem 0; color: var(--text-secondary); font-size: .92rem; }
  .diff { overflow: hidden; border: 1px solid var(--glass-border); border-radius: var(--radius-sm); background: var(--bg-secondary); font: .72rem/1.55 var(--font-terminal); }
  .diff-file { padding: .45rem .7rem; border-bottom: 1px solid var(--glass-border); color: var(--text-dim); }
  .diff p { display: grid; grid-template-columns: 1rem minmax(0, 1fr); gap: .35rem; padding: .25rem .7rem; color: var(--text-secondary); }
  .diff p span { color: var(--accent-sage); }
  .tags { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .9rem; }
  .tags li { padding: .22rem .5rem; border: 1px solid var(--glass-border); border-radius: 999px; color: var(--text-muted); font: .62rem var(--font-terminal); }
  @media (max-width: 640px) {
    .scope-bar { display: grid; grid-template-columns: 1fr 1fr; }
    .career-entry { grid-template-columns: 24px minmax(0, 1fr); }
    .entry-card { padding: 1rem; }
    .entry-heading { flex-direction: column; gap: .45rem; }
    time { white-space: normal; }
    .diff { font-size: .66rem; }
  }
</style>
