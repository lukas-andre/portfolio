---
import CinematicReveal from './ui/CinematicReveal.astro';
import { profile } from '../data/profile';

const lanes = [profile.agentSystem.personal, profile.agentSystem.corporate];
---

<section id="ai" class="section agent-system">
  <CinematicReveal>
    <header class="section-header">
      <span class="section-cmd">systemctl status agent-harness</span>
      <h2 class="section-title"><span>[</span> Agent Operating System <span>]</span></h2>
      <p class="section-intro">
        Agents are replaceable. The durable advantage is the system around them: memory, orchestration,
        scoped tools, observability and human judgment.
      </p>
    </header>
  </CinematicReveal>

  <CinematicReveal delay={0.15}>
    <div class="architecture" aria-label="Agent operating system architecture">
      <div class="terminal-bar">
        <div class="terminal-dots" aria-hidden="true"><i></i><i></i><i></i></div>
        <code>lucas@arch ~/systems/agent-os</code>
        <span class="live"><i></i> 2 environments</span>
      </div>

      <div class="lanes">
        {lanes.map((lane, laneIndex) => (
          <article class:list={['lane', { corporate: laneIndex === 1 }]}>
            <header>
              <div>
                <span class="lane-index">0{laneIndex + 1} / ENVIRONMENT</span>
                <h3>{lane.title}</h3>
              </div>
              <span class:list={['lane-status', { building: lane.status === 'BUILDING' }]}>{lane.status}</span>
            </header>
            <p>{lane.description}</p>

            <div class="flow">
              {lane.nodes.map((node, index) => (
                <>
                  <div class="node">
                    <span class="node-role">{node.role}</span>
                    <strong>{node.name}</strong>
                    <span class={`status status--${node.status.replaceAll(' ', '-')}`}>{node.status}</span>
                  </div>
                  {index < lane.nodes.length - 1 && <span class="arrow" aria-hidden="true">↓</span>}
                </>
              ))}
            </div>
          </article>
        ))}
      </div>

      <div class="harness-layer">
        <div class="harness-title">
          <span>SHARED HARNESS</span>
          <small>evidence before claims</small>
        </div>
        <ul>
          {profile.agentSystem.harness.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </CinematicReveal>

  <CinematicReveal delay={0.35}>
    <div class="principles">
      <article>
        <span>01 / CONTEXT</span>
        <h3>Memory that compounds</h3>
        <p>Decisions and sources live outside any single model session, ready to be reused and challenged.</p>
      </article>
      <article>
        <span>02 / ORCHESTRATION</span>
        <h3>The right runtime for the job</h3>
        <p>Herdr coordinates specialized agents; workflows define boundaries, handoffs and recovery paths.</p>
      </article>
      <article>
        <span>03 / VERIFICATION</span>
        <h3>Done means evidenced</h3>
        <p>Tests, evals, traces and human approval turn an agent's claim into an accountable deliverable.</p>
      </article>
    </div>
  </CinematicReveal>

  <CinematicReveal delay={0.5}>
    <blockquote>
      <code>echo $OPERATING_PRINCIPLE</code>
      <p>“I don't optimize for more AI output. I build the harness that makes useful output trustworthy.”</p>
    </blockquote>
  </CinematicReveal>
</section>

<style>
  .agent-system { position: relative; overflow: hidden; background: linear-gradient(180deg, var(--bg-secondary), var(--bg-primary), var(--bg-secondary)); }
  .agent-system::before { position: absolute; inset: 8% -10% auto; height: 22rem; background: radial-gradient(circle, color-mix(in srgb, var(--accent-amber) 10%, transparent), transparent 65%); content: ''; pointer-events: none; }
  .section-header { position: relative; z-index: 1; margin-bottom: 2.25rem; }
  .section-cmd { display: block; margin-bottom: .5rem; color: var(--accent-gold); font: .8rem var(--font-terminal); }
  .section-title { display: flex; gap: .5rem; align-items: center; color: var(--text-primary); font-size: clamp(2rem, 5vw, 3rem); font-weight: 600; }
  .section-title span { color: var(--accent-amber); font-weight: 300; }
  .section-intro { max-width: 760px; margin-top: .8rem; color: var(--text-secondary); font-size: clamp(.95rem, 1.5vw, 1.08rem); }
  .architecture { position: relative; overflow: hidden; max-width: 1080px; margin: 0 auto 2rem; border: 1px solid var(--glass-border); border-radius: var(--radius-lg); background: var(--bg-card); box-shadow: var(--shadow-card); }
  .terminal-bar { display: flex; align-items: center; gap: 1rem; padding: .75rem 1rem; border-bottom: 1px solid var(--glass-border); background: var(--bg-tertiary); color: var(--text-muted); font: .68rem var(--font-terminal); }
  .terminal-dots { display: flex; gap: 5px; }
  .terminal-dots i { width: 9px; height: 9px; border-radius: 50%; background: var(--text-dim); }
  .terminal-dots i:nth-child(1) { background: var(--accent-rust); }
  .terminal-dots i:nth-child(2) { background: var(--accent-amber); }
  .terminal-dots i:nth-child(3) { background: var(--accent-sage); }
  .live { display: flex; align-items: center; gap: .4rem; margin-left: auto; color: var(--accent-sage); }
  .live i { width: 6px; height: 6px; border-radius: 50%; background: currentColor; box-shadow: 0 0 8px currentColor; }
  .lanes { display: grid; grid-template-columns: 1fr 1fr; }
  .lane { padding: clamp(1.1rem, 2.5vw, 1.75rem); }
  .lane + .lane { border-left: 1px solid var(--glass-border); }
  .lane > header { display: flex; justify-content: space-between; gap: 1rem; align-items: flex-start; }
  .lane-index { color: var(--text-dim); font: .58rem var(--font-terminal); letter-spacing: .12em; }
  .lane h3 { margin-top: .25rem; color: var(--text-primary); font-size: clamp(1rem, 2.4vw, 1.25rem); }
  .lane-status { padding: .25rem .5rem; border: 1px solid var(--accent-sage); border-radius: 999px; color: var(--accent-sage); font: 600 .57rem var(--font-terminal); letter-spacing: .08em; }
  .lane-status.building { border-color: var(--accent-amber); color: var(--accent-amber); }
  .lane > p { min-height: 4.4rem; margin: .85rem 0 1.15rem; color: var(--text-muted); font-size: .82rem; }
  .flow { display: flex; flex-direction: column; align-items: stretch; }
  .node { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: .15rem 1rem; padding: .75rem .85rem; border: 1px solid var(--glass-border); border-radius: var(--radius-md); background: var(--bg-secondary); }
  .node-role { grid-column: 1 / -1; color: var(--text-dim); font: .56rem var(--font-terminal); text-transform: uppercase; letter-spacing: .08em; }
  .node strong { min-width: 0; color: var(--accent-cream); font: 500 .72rem var(--font-terminal); overflow-wrap: anywhere; }
  .status { align-self: center; color: var(--accent-sage); font: .55rem var(--font-terminal); white-space: nowrap; }
  .status--adopting, .status--building { color: var(--accent-amber); }
  .status--required { color: var(--accent-rust); }
  .arrow { height: 1.2rem; color: var(--accent-amber); font: .8rem/1.2rem var(--font-terminal); text-align: center; }
  .harness-layer { display: grid; grid-template-columns: auto 1fr; gap: 1.25rem; align-items: center; padding: 1.15rem 1.5rem; border-top: 1px solid var(--glass-border); background: color-mix(in srgb, var(--accent-amber) 7%, var(--bg-tertiary)); }
  .harness-title { display: flex; flex-direction: column; color: var(--accent-amber); font: 600 .7rem var(--font-terminal); letter-spacing: .08em; }
  .harness-title small { margin-top: .2rem; color: var(--text-muted); font-size: .58rem; letter-spacing: 0; }
  .harness-layer ul { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .45rem; }
  .harness-layer li { padding: .3rem .55rem; border: 1px solid var(--glass-border); border-radius: 999px; background: var(--bg-card); color: var(--text-secondary); font: .61rem var(--font-terminal); }
  .principles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; max-width: 1080px; margin: 0 auto 2rem; }
  .principles article { padding: 1.1rem; border-top: 2px solid var(--accent-sage); background: color-mix(in srgb, var(--bg-card) 85%, transparent); }
  .principles article:nth-child(2) { border-color: var(--accent-amber); }
  .principles article:nth-child(3) { border-color: var(--accent-rust); }
  .principles span { color: var(--text-dim); font: .58rem var(--font-terminal); letter-spacing: .08em; }
  .principles h3 { margin: .55rem 0 .35rem; color: var(--text-primary); font-size: .96rem; }
  .principles p { color: var(--text-muted); font-size: .78rem; }
  blockquote { max-width: 1080px; margin: 0 auto; padding: 1rem 1.25rem; border-left: 3px solid var(--accent-amber); background: var(--bg-tertiary); }
  blockquote code { color: var(--accent-sage); font: .65rem var(--font-terminal); }
  blockquote p { margin-top: .45rem; color: var(--text-primary); font: clamp(1rem, 2vw, 1.2rem) var(--font-editorial); }
  @media (max-width: 760px) {
    .terminal-bar code { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .live { display: none; }
    .lanes { grid-template-columns: 1fr; }
    .lane + .lane { border-top: 1px solid var(--glass-border); border-left: 0; }
    .lane > p { min-height: 0; }
    .harness-layer { grid-template-columns: 1fr; }
    .harness-layer ul { justify-content: flex-start; }
    .principles { grid-template-columns: 1fr; }
  }
  @media (max-width: 420px) {
    .node { grid-template-columns: 1fr; }
    .status { justify-self: start; }
  }
</style>
