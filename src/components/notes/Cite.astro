---
import { getEntry } from 'astro:content';

interface Props { source: string; locator: string; }
const { source, locator } = Astro.props;
const entry = await getEntry('sources', source);
if (!entry) throw new Error(`Unknown source: ${source}`);
---

<a class="citation" href={entry.data.url} target="_blank" rel="noopener noreferrer" title={`${entry.data.title} — ${locator}`}>
  [{entry.data.identifier}, {locator}]<span class="sr-only"> ({entry.data.title})</span>
</a>

<style>
  .citation { font: 500 .72em/1.2 var(--font-terminal); color: var(--accent-amber); white-space: normal; overflow-wrap: anywhere; border-bottom: 1px dotted currentColor; }
  .citation:hover { color: var(--accent-cream); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
</style>
