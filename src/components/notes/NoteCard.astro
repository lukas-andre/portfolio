---
import type { NoteEntry } from '../../lib/notes';
import { notePath, readingMinutes } from '../../lib/notes';

interface Props { note: NoteEntry; }
const { note } = Astro.props;
const isSpanish = note.data.lang === 'es';
const date = note.data.publishedAt ?? note.data.updatedAt;
const kindLabel = note.data.kind === 'essay'
  ? (isSpanish ? 'ENSAYO' : 'ESSAY')
  : note.data.kind === 'synthesis'
    ? (isSpanish ? 'SÍNTESIS' : 'SYNTHESIS')
    : (isSpanish ? 'LECTURA' : 'READING');
---

<article class="note-card">
  <div class="note-card__meta">
    <span>{kindLabel}</span>
    <span aria-hidden="true">·</span>
    <span>{readingMinutes(note)} min</span>
    {note.data.draft && <span class="note-card__draft">{isSpanish ? 'BORRADOR' : 'DRAFT'}</span>}
  </div>
  <h2><a href={notePath(note)}>{note.data.title}</a></h2>
  <p>{note.data.description}</p>
  <div class="note-card__footer">
    <ul aria-label={isSpanish ? 'Etiquetas' : 'Tags'}>
      {note.data.tags.slice(0, 3).map((tag) => <li>#{tag}</li>)}
    </ul>
    {date && <time datetime={date.toISOString()}>{new Intl.DateTimeFormat(note.data.lang, { dateStyle: 'medium', timeZone: 'UTC' }).format(date)}</time>}
  </div>
</article>

<style>
  .note-card {
    padding: clamp(1.5rem, 4vw, 2.25rem) 0;
    border-top: 1px solid var(--glass-border);
  }

  .note-card__meta,
  .note-card__footer,
  .note-card ul {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.65rem;
    font-family: var(--font-terminal);
    font-size: 0.66rem;
    color: var(--text-muted);
    letter-spacing: 0.055em;
  }

  .note-card__draft {
    padding: 0.1rem 0.4rem;
    color: var(--accent-amber);
    border: 1px solid color-mix(in srgb, var(--accent-amber) 35%, transparent);
  }

  h2 {
    max-width: 820px;
    margin: 0.75rem 0;
    font-family: var(--font-editorial);
    font-size: clamp(1.9rem, 5vw, 3.2rem);
    font-weight: 450;
    letter-spacing: -0.035em;
  }

  h2 a { background: linear-gradient(var(--accent-amber), var(--accent-amber)) 0 100% / 0 1px no-repeat; }
  h2 a:hover { color: var(--accent-cream); background-size: 100% 1px; }
  p { max-width: 70ch; font-size: 1rem; }

  .note-card__footer { justify-content: space-between; margin-top: 1.2rem; }
  .note-card li { color: var(--accent-sage); }
</style>
