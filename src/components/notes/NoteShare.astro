---
interface Props {
  title: string;
  url: string;
  lang: 'es' | 'en';
  placement: 'header' | 'footer';
}
const { title, url, lang, placement } = Astro.props;
const es = lang === 'es';
const linkedinUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`;
const emailUrl = `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(url)}`;
---

<div class:list={['note-share', `note-share--${placement}`]} role="group" aria-label={es ? 'Compartir artículo' : 'Share article'} data-title={title} data-url={url}>
  <details class="note-share__menu">
    <summary class="note-share__trigger">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 15V3m-4 4 4-4 4 4M5 12v8a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-8" /></svg>
      {es ? 'Compartir' : 'Share'}
    </summary>
    <div class="note-share__choices">
      <a href={linkedinUrl} target="_blank" rel="noopener noreferrer">{es ? 'Compartir en LinkedIn' : 'Share on LinkedIn'}<span aria-hidden="true">↗</span></a>
      <a href={emailUrl}>{es ? 'Enviar por correo' : 'Send by email'}<span aria-hidden="true">↗</span></a>
    </div>
  </details>
  <button type="button" class="note-share__copy" hidden data-idle={es ? 'Copiar enlace' : 'Copy link'} data-success={es ? 'Enlace copiado' : 'Link copied'} data-error={es ? 'No se pudo copiar' : 'Could not copy'}>
    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m10 13 4-4m-6 6-1 1a4 4 0 0 1-6-6l4-4a4 4 0 0 1 6 0m2 2 1-1a4 4 0 0 1 6 6l-4 4a4 4 0 0 1-6 0" transform="translate(1 1)" /></svg>
    <span>{es ? 'Copiar enlace' : 'Copy link'}</span>
  </button>
  <span class="note-share__status sr-only" role="status" aria-live="polite" aria-atomic="true"></span>
</div>

<script>
  async function copyLink(value: string) {
    try {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(value);
        return;
      }
    } catch {
      // Embedded browsers can expose the clipboard API but reject the write.
    }
    const focused = document.activeElement;
    const textarea = document.createElement('textarea');
    textarea.value = value;
    textarea.setAttribute('readonly', '');
    textarea.style.cssText = 'position:fixed;opacity:0;left:0;top:0';
    document.body.append(textarea);
    try {
      textarea.select();
      if (!document.execCommand('copy')) throw new Error('Copy failed');
    } finally {
      textarea.remove();
      if (focused instanceof HTMLElement) focused.focus({ preventScroll: true });
    }
  }

  document.querySelectorAll<HTMLElement>('.note-share').forEach((group) => {
    const menu = group.querySelector<HTMLDetailsElement>('details');
    const trigger = group.querySelector<HTMLElement>('summary');
    const copy = group.querySelector<HTMLButtonElement>('.note-share__copy');
    const status = group.querySelector<HTMLElement>('.note-share__status');
    const label = copy?.querySelector('span');
    const url = group.dataset.url;
    if (!menu || !trigger || !copy || !label || !status || !url) return;
    copy.hidden = false;
    let sharing = false;
    let resetTimer: number | undefined;

    trigger.addEventListener('click', async (event) => {
      if (!navigator.share) return; // Native details remains a no-JS/browser fallback.
      event.preventDefault();
      if (sharing) return;
      menu.open = false;
      sharing = true;
      try {
        await navigator.share({ title: group.dataset.title, url });
      } catch (error) {
        if (!(error instanceof DOMException && error.name === 'AbortError')) menu.open = true;
      } finally {
        sharing = false;
      }
    });

    copy.addEventListener('click', async () => {
      window.clearTimeout(resetTimer);
      const restoreFocus = document.activeElement === copy;
      copy.disabled = true;
      status.textContent = '';
      menu.open = false;
      try {
        await copyLink(url);
        label.textContent = copy.dataset.success ?? 'Link copied';
      } catch {
        label.textContent = copy.dataset.error ?? 'Could not copy';
      } finally {
        status.textContent = label.textContent;
        copy.disabled = false;
        if (restoreFocus && document.activeElement === document.body) copy.focus({ preventScroll: true });
        resetTimer = window.setTimeout(() => {
          label.textContent = copy.dataset.idle ?? 'Copy link';
          status.textContent = '';
        }, 2400);
      }
    });

    group.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        trigger.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !group.contains(event.target)) menu.open = false;
    });
  });
</script>

<style>
  .note-share { display: flex; align-items: center; flex-wrap: wrap; gap: .6rem; position: relative; font: 500 .75rem/1.3 var(--font-terminal); }
  .note-share--header { justify-content: center; margin-top: 1.6rem; }
  .note-share__menu { position: relative; }
  .note-share__trigger, .note-share__copy { display: inline-flex; align-items: center; justify-content: center; gap: .55rem; min-height: 44px; padding: .75rem 1rem; border: 1px solid var(--glass-border); color: var(--accent-cream); background: transparent; cursor: pointer; font: inherit; }
  .note-share__trigger { list-style: none; border-color: var(--accent-amber); color: var(--accent-amber); }
  .note-share__trigger::-webkit-details-marker { display: none; }
  .note-share__copy[hidden] { display: none; }
  .note-share__trigger:hover, .note-share__copy:hover { background: var(--bg-secondary); border-color: var(--accent-amber); }
  .note-share__trigger:focus-visible, .note-share__copy:focus-visible, .note-share__choices a:focus-visible { outline: 2px solid var(--accent-amber); outline-offset: 4px; }
  .note-share__copy:disabled { cursor: wait; opacity: .65; }
  .note-share__choices { position: absolute; z-index: 20; top: calc(100% + .5rem); left: 0; width: max-content; min-width: 230px; max-width: calc(100vw - 3rem); padding: .4rem; border: 1px solid var(--glass-border); background: var(--bg-void); box-shadow: 0 12px 30px var(--glass-border); text-align: left; }
  .note-share__choices a { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 44px; padding: .7rem .65rem; color: var(--accent-cream); text-decoration: none; }
  .note-share__choices a:hover { color: var(--accent-amber); background: var(--bg-secondary); }
  .note-share--footer .note-share__choices { top: auto; bottom: calc(100% + .5rem); }
</style>
