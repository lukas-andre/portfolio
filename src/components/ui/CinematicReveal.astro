---
interface Props {
  direction?: 'up' | 'down' | 'left' | 'right' | 'scale';
  delay?: number;
  duration?: number;
  className?: string;
  once?: boolean;
}
const { direction = 'up', delay = 0, duration = 0.8, className = '', once = true } = Astro.props;
---

<div class:list={['cinematic-reveal', className]} data-reveal data-direction={direction}
  data-once={String(once)} style={`--reveal-delay:${Math.min(delay, 0.2)}s;--reveal-duration:${duration}s`}>
  <slot />
</div>

<script>
  const elements = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.remove('reveal-pending');
          if ((entry.target as HTMLElement).dataset.once !== 'false') observer.unobserve(entry.target);
        }
      }
    }, { threshold: 0.04 });
    elements.forEach((element) => {
      // First paint and no-JS readers always see content. Only enhance offscreen blocks.
      if (element.getBoundingClientRect().top >= innerHeight) element.classList.add('reveal-pending');
      observer.observe(element);
    });
    matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', () => {
      observer.disconnect();
      elements.forEach((element) => element.classList.remove('reveal-pending'));
    }, { once: true });
  }
</script>

<style>
  .cinematic-reveal { transition: opacity var(--reveal-duration) ease var(--reveal-delay), transform var(--reveal-duration) cubic-bezier(.16,1,.3,1) var(--reveal-delay); }
  .reveal-pending { opacity: 0; transform: translateY(24px); }
  .reveal-pending[data-direction='down'] { transform: translateY(-24px); }
  .reveal-pending[data-direction='left'] { transform: translateX(24px); }
  .reveal-pending[data-direction='right'] { transform: translateX(-24px); }
  .reveal-pending[data-direction='scale'] { transform: scale(.97); }
  @media (prefers-reduced-motion: reduce) { .cinematic-reveal { opacity: 1; transform: none; transition: none; } }
</style>
