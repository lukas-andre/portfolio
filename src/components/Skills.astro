---
import CinematicReveal from './ui/CinematicReveal.tsx';
import { profile } from '../data/profile';

const totalCapabilities = profile.capabilityGroups.reduce((total, group) => total + group.items.length, 0);
---

<section id="skills" class="section skills">
  <CinematicReveal client:load>
    <header class="section-header">
      <span class="section-cmd">pacman -Syu --needed capability-stack</span>
      <h2 class="section-title"><span>[</span> Capability Stack <span>]</span></h2>
      <p class="section-intro">No percentages or vanity versions—just the systems I lead, build and operate.</p>
    </header>
  </CinematicReveal>

  <CinematicReveal client:load delay={0.1}>
    <div class="package-summary">
      <span><i></i> system online</span>
      <code>{profile.capabilityGroups.length} modules / {totalCapabilities} capabilities</code>
    </div>
  </CinematicReveal>

  <div class="skills-grid">
    {profile.capabilityGroups.map((group, index) => (
      <CinematicReveal client:load delay={Math.min(0.12 * (index + 1), 0.55)}>
        <article class:list={['module', { highlight: 'highlight' in group && group.highlight }]}>
          <header>
            <span class="repo">{group.repo}</span>
            <h3>{group.title}</h3>
            <span class="count">[{group.items.length}]</span>
          </header>
          <p class="module-note">{group.note}</p>
          <ul>
            {group.items.map((item) => (
              <li>
                <span class="package-name">{item.name}</span>
                <span class="package-detail">{item.detail}</span>
              </li>
            ))}
          </ul>
          <footer><span>::</span> installed as practice, not decoration</footer>
        </article>
      </CinematicReveal>
    ))}
  </div>
</section>

<style>
  .skills { background: linear-gradient(180deg, var(--bg-secondary), var(--bg-primary), var(--bg-secondary)); }
  .section-header { margin-bottom: 2rem; }
  .section-cmd { display: block; margin-bottom: .5rem; color: var(--accent-amber); font: .8rem var(--font-terminal); }
  .section-title { display: flex; gap: .5rem; align-items: center; color: var(--text-primary); font-size: clamp(2rem, 5vw, 3rem); font-weight: 600; }
  .section-title span { color: var(--accent-amber); font-weight: 300; }
  .section-intro { max-width: 650px; margin-top: .7rem; color: var(--text-muted); }
  .package-summary { display: flex; justify-content: space-between; gap: 1rem; margin-bottom: 2rem; padding: .8rem 1rem; border: 1px solid var(--glass-border); border-radius: var(--radius-md); background: var(--bg-tertiary); color: var(--text-muted); font: .7rem var(--font-terminal); }
  .package-summary span { display: flex; align-items: center; gap: .5rem; color: var(--accent-sage); }
  .package-summary i { width: 7px; height: 7px; border-radius: 50%; background: var(--accent-sage); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent-sage) 15%, transparent); }
  .skills-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .module { height: 100%; overflow: hidden; border: 1px solid var(--glass-border); border-radius: var(--radius-lg); background: var(--bg-card); box-shadow: var(--shadow-terminal); transition: transform var(--transition-medium), border-color var(--transition-medium); }
  .module:hover { transform: translateY(-3px); border-color: var(--accent-sage); }
  .module.highlight { border-color: color-mix(in srgb, var(--accent-amber) 55%, var(--glass-border)); }
  .module header { display: flex; align-items: center; gap: .6rem; padding: .8rem 1rem; border-bottom: 1px solid var(--glass-border); background: var(--bg-tertiary); font-family: var(--font-terminal); }
  .repo { padding: .1rem .4rem; border: 1px solid var(--accent-sage); border-radius: 3px; color: var(--accent-sage); font-size: .62rem; }
  .module.highlight .repo { border-color: var(--accent-amber); color: var(--accent-amber); }
  h3 { flex: 1; color: var(--text-primary); font: 600 .78rem var(--font-terminal); text-transform: uppercase; letter-spacing: .04em; }
  .count { color: var(--text-dim); font-size: .68rem; }
  .module-note { min-height: 3.2rem; padding: .8rem 1rem .55rem; color: var(--text-muted); font-size: .82rem; }
  .module ul { padding: 0 .75rem .8rem; }
  .module li { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: .8rem; padding: .6rem .35rem; border-bottom: 1px dashed var(--glass-border); font-family: var(--font-terminal); }
  .module li:last-child { border-bottom: 0; }
  .package-name { overflow-wrap: anywhere; color: var(--accent-cream); font-size: .72rem; }
  .package-detail { color: var(--text-muted); font-size: .66rem; text-align: right; }
  .module footer { padding: .6rem 1rem; border-top: 1px solid var(--glass-border); color: var(--text-dim); font: .6rem var(--font-terminal); }
  .module footer span { color: var(--accent-amber); }
  @media (min-width: 1000px) { .skills-grid > :nth-child(2) { grid-column: span 1; } .skills-grid > :last-child { grid-column: 1 / -1; } }
  @media (max-width: 760px) {
    .skills-grid { grid-template-columns: 1fr; }
    .package-summary { align-items: flex-start; flex-direction: column; }
    .module-note { min-height: 0; }
  }
  @media (max-width: 420px) {
    .module li { grid-template-columns: 1fr; gap: .2rem; }
    .package-detail { text-align: left; }
  }
</style>
