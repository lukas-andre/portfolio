---
import GlitchText from './ui/GlitchText.tsx';
import TypeWriter from './ui/TypeWriter.tsx';
import CinematicReveal from './ui/CinematicReveal.tsx';
import { notePath, readingMinutes, type NoteEntry } from '../lib/notes';
import { profile } from '../data/profile';

interface Props {
  latestNote?: NoteEntry;
  latestTranslation?: NoteEntry;
  latestNoteNumber?: number;
}

const { latestNote, latestTranslation, latestNoteNumber = 1 } = Astro.props;
const latestDate = latestNote?.data.publishedAt ?? latestNote?.data.updatedAt;
const latestDateLabel = latestDate
  ? new Intl.DateTimeFormat('en', {
      day: '2-digit',
      month: 'short',
      year: 'numeric',
      timeZone: 'UTC',
    }).format(latestDate).toUpperCase()
  : undefined;
---

<section id="hero" class:list={['hero', { 'hero--with-note': latestNote }]}>
  <div class="hero-content">
    <CinematicReveal client:load delay={0.3}>
      <div class="hero-terminal-line">
        <span class="prompt-user">lucas</span>
        <span class="prompt-at">@</span>
        <span class="prompt-host">arch</span>
        <span class="prompt-separator">:</span>
        <span class="prompt-path">~</span>
        <span class="prompt-symbol">$</span>
        <TypeWriter client:load text="whoami --verbose" delay={800} speed={60} />
      </div>
    </CinematicReveal>

    <CinematicReveal client:load delay={0.6}>
      <div class="hero-identity">
        <div class="hero-photo-small">
          <div class="photo-wrapper">
            <img src="/images/profile.jpeg" alt="Lucas Henry" class="profile-photo" />
          </div>
          <div class="photo-frame-glow"></div>
        </div>
        <div class="hero-name-container">
          <h1 class="hero-name">
            <GlitchText client:load className="name-text">
              Lucas Henry
            </GlitchText>
          </h1>
        </div>
      </div>
    </CinematicReveal>

    <CinematicReveal client:load delay={0.9}>
      <div class="hero-roles">
        <span class="role-badge primary">{profile.role}</span>
        <span class="role-separator">//</span>
        <span class="role-badge">Self Service</span>
        <span class="role-separator">//</span>
        <span class="role-badge highlight">Agentic Systems</span>
      </div>
    </CinematicReveal>

    <CinematicReveal client:load delay={1.1}>
      <div class="hero-output">
        <p class="output-line">
          <span class="output-key">company</span>
          <span class="output-colon">:</span>
          <span class="output-value company">"{profile.company}"</span>
        </p>
        <p class="output-line">
          <span class="output-key">domain</span>
          <span class="output-colon">:</span>
          <span class="output-value">"{profile.domain}"</span>
        </p>
        <p class="output-line">
          <span class="output-key">scope</span>
          <span class="output-colon">:</span>
          <span class="output-value">"7 capabilities · 3 teams · ~30 people"</span>
        </p>
        <p class="output-line">
          <span class="output-key">practice</span>
          <span class="output-colon">:</span>
          <span class="output-value status">"Harness Engineering"</span>
        </p>
      </div>
    </CinematicReveal>

    <CinematicReveal client:load delay={1.4}>
      <div class="hero-cta">
        <a href="#contact" class="btn btn-primary">
          <span>ssh connect</span>
          <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <a href="/resume/" class="btn btn-secondary">
          <span>open ~/resume</span>
        </a>
      </div>
    </CinematicReveal>
  </div>

  {latestNote && (
    <aside class="hero-latest" aria-label="Latest research note">
      <div class="latest-note__header">
        <span class="latest-note__label"><i></i> Latest / research note</span>
        <span class="latest-note__number">Nº {String(latestNoteNumber).padStart(2, '0')}</span>
      </div>

      <a
        class="latest-note__primary"
        href={notePath(latestNote)}
        aria-label={`Read research note: ${latestNote.data.title}`}
      >
        <figure class="latest-note__visual">
          <img
            src={latestNote.data.diagrams[0].src}
            alt={latestNote.data.diagrams[0].alt}
            loading="eager"
            decoding="async"
          />
          <figcaption>
            <span>FIG. 01</span>
            <span>Inside the note ↗</span>
          </figcaption>
        </figure>

        <div class="latest-note__meta">
          {latestDate && latestDateLabel && (
            <time datetime={latestDate.toISOString()}>{latestDateLabel}</time>
          )}
          <span aria-hidden="true">·</span>
          <span>{readingMinutes(latestNote)} min read</span>
        </div>

        <h2 id="latest-note-title">{latestNote.data.title}</h2>
        <span class="latest-note__open">
          Read the visual note
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </span>
      </a>

      <div class="latest-note__footer">
        <ul aria-label="Topics">
          {latestNote.data.tags.slice(0, 2).map((tag) => <li>#{tag}</li>)}
        </ul>
        {latestTranslation && (
          <a
            class="latest-note__language"
            href={notePath(latestTranslation)}
            hreflang={latestTranslation.data.lang}
            aria-label="Leer esta nota en español"
          >
            ES <span aria-hidden="true">↗</span>
          </a>
        )}
      </div>
    </aside>
  )}

  <!-- Scroll indicator -->
  <div class="scroll-indicator">
    <div class="scroll-mouse">
      <div class="scroll-wheel"></div>
    </div>
    <span class="scroll-text">scroll</span>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 8rem 5% 4rem;
    position: relative;
    overflow: hidden;
    width: min(100%, 1600px);
    margin: 0 auto;
  }

  .hero--with-note {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(330px, 420px);
    gap: clamp(3rem, 7vw, 8rem);
  }

  .hero-content {
    max-width: 750px;
    position: relative;
    z-index: 1;
  }

  /* Terminal prompt line */
  .hero-terminal-line {
    font-family: var(--font-terminal);
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0;
  }

  .prompt-user {
    color: var(--accent-sage);
    font-weight: 500;
  }

  .prompt-at {
    color: var(--text-muted);
  }

  .prompt-host {
    color: var(--accent-amber);
    font-weight: 500;
  }

  .prompt-separator {
    color: var(--text-muted);
  }

  .prompt-path {
    color: var(--accent-cream);
  }

  .prompt-symbol {
    color: var(--text-muted);
    margin-right: 0.75rem;
  }

  /* Identity section with photo */
  .hero-identity {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-bottom: 1.5rem;
  }

  .hero-photo-small {
    position: relative;
    width: 100px;
    height: 100px;
    flex-shrink: 0;
  }

  .photo-wrapper {
    width: 100%;
    height: 100%;
    border: 2px solid var(--glass-border);
    border-radius: var(--radius-lg);
    position: relative;
    overflow: hidden;
  }

  .profile-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: grayscale(20%) contrast(1.05);
    transition: filter 0.3s ease;
  }

  .hero-photo-small:hover .profile-photo {
    filter: grayscale(0%) contrast(1.1);
  }

  .photo-wrapper::before {
    content: '';
    position: absolute;
    inset: 0;
    border: 2px solid transparent;
    border-radius: inherit;
    background: linear-gradient(135deg, var(--accent-amber), var(--accent-gold), var(--accent-cream)) border-box;
    -webkit-mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
    mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    animation: rotate-border 6s linear infinite;
  }

  @keyframes rotate-border {
    to {
      filter: hue-rotate(30deg);
    }
  }

  .photo-frame-glow {
    position: absolute;
    inset: -8px;
    background: radial-gradient(circle, rgba(212, 165, 116, 0.2) 0%, transparent 70%);
    border-radius: var(--radius-xl);
    z-index: -1;
    animation: glow-pulse 3s ease-in-out infinite;
  }

  @keyframes glow-pulse {
    0%, 100% { opacity: 0.5; transform: scale(1); }
    50% { opacity: 0.8; transform: scale(1.05); }
  }

  .hero-name-container {
    flex: 1;
  }

  .hero-name {
    font-size: clamp(2.5rem, 8vw, 5rem);
    font-weight: 600;
    line-height: 1;
  }

  .hero-name :global(.name-text) {
    background: linear-gradient(135deg, var(--text-primary) 0%, var(--accent-cream) 40%, var(--accent-amber) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Roles */
  .hero-roles {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .role-badge {
    font-family: var(--font-terminal);
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--text-secondary);
    padding: 0.4rem 0.75rem;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-sm);
  }

  .role-badge.primary {
    border-color: var(--accent-amber);
    color: var(--accent-amber);
  }

  .role-badge.highlight {
    background: rgba(201, 148, 58, 0.15);
    border-color: var(--accent-gold);
    color: var(--accent-gold);
  }

  .role-separator {
    color: var(--text-dim);
    font-family: var(--font-terminal);
  }

  /* Output section */
  .hero-output {
    font-family: var(--font-terminal);
    font-size: 0.85rem;
    margin-bottom: 2.5rem;
    padding: 1.25rem;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
  }

  .output-line {
    margin-bottom: 0.35rem;
    display: flex;
    gap: 0.5rem;
  }

  .output-line:last-child {
    margin-bottom: 0;
  }

  .output-key {
    color: var(--accent-cream);
    min-width: 70px;
  }

  .output-colon {
    color: var(--text-dim);
  }

  .output-value {
    color: var(--accent-sage);
  }

  .output-value.company {
    color: var(--accent-amber);
    font-weight: 500;
  }

  .output-value.status {
    color: var(--accent-gold);
  }

  /* CTA */
  .hero-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* Latest research note — an editorial margin, not another app window */
  .hero-latest {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 400px;
    justify-self: end;
    padding-left: clamp(1rem, 2.4vw, 2rem);
    animation: latest-note-in 900ms 350ms var(--ease-out-expo) both;
  }

  .hero-latest::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 1px;
    background: linear-gradient(180deg, var(--accent-amber), color-mix(in srgb, var(--accent-amber) 22%, transparent) 72%, transparent);
  }

  @keyframes latest-note-in {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .latest-note__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--glass-border);
    font-family: var(--font-terminal);
    font-size: 0.6rem;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .latest-note__label {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--accent-amber);
  }

  .latest-note__label i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent-amber) 11%, transparent);
  }

  .latest-note__number {
    color: var(--text-dim);
  }

  .latest-note__primary {
    display: block;
    padding-top: 1rem;
  }

  .latest-note__visual {
    position: relative;
    aspect-ratio: 1.9;
    overflow: hidden;
    background: var(--diagram-surface);
    border: 1px solid color-mix(in srgb, var(--accent-cream) 18%, transparent);
    box-shadow: 0 16px 34px color-mix(in srgb, var(--text-primary) 13%, transparent);
  }

  .latest-note__visual::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid color-mix(in srgb, var(--accent-amber) 0%, transparent);
    transition: border-color var(--transition-medium);
    pointer-events: none;
  }

  .latest-note__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.82) contrast(1.02);
    transition: transform 650ms var(--ease-out-expo), filter var(--transition-medium);
  }

  .latest-note__visual figcaption {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.8rem 0.75rem 0.55rem;
    background: linear-gradient(transparent, rgba(13, 13, 11, 0.9));
    font-family: var(--font-terminal);
    font-size: 0.55rem;
    color: #f5f2eb;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .latest-note__primary:hover .latest-note__visual img {
    transform: scale(1.025);
    filter: saturate(1) contrast(1.05);
  }

  .latest-note__primary:hover .latest-note__visual::after {
    border-color: color-mix(in srgb, var(--accent-amber) 68%, transparent);
  }

  .latest-note__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1rem 0 0.6rem;
    font-family: var(--font-terminal);
    font-size: 0.59rem;
    color: var(--text-muted);
    letter-spacing: 0.055em;
  }

  .latest-note__primary h2 {
    margin: 0;
    font-family: var(--font-editorial);
    font-size: clamp(1.7rem, 2.35vw, 2.15rem);
    font-weight: 450;
    line-height: 1.02;
    letter-spacing: -0.035em;
    text-wrap: balance;
    transition: color var(--transition-fast);
  }

  .latest-note__primary:hover h2 {
    color: var(--accent-cream);
  }

  .latest-note__open {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 0.85rem;
    font-family: var(--font-terminal);
    font-size: 0.64rem;
    font-weight: 500;
    color: var(--accent-amber);
    letter-spacing: 0.04em;
  }

  .latest-note__open svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    transition: transform var(--transition-fast);
  }

  .latest-note__primary:hover .latest-note__open svg {
    transform: translateX(4px);
  }

  .latest-note__footer,
  .latest-note__footer ul {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
  }

  .latest-note__footer {
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 1rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--glass-border);
    font-family: var(--font-terminal);
    font-size: 0.56rem;
    letter-spacing: 0.045em;
  }

  .latest-note__footer ul {
    gap: 0.7rem;
    color: var(--accent-sage);
  }

  .latest-note__language {
    color: var(--accent-amber);
  }

  .latest-note__language:hover {
    color: var(--accent-cream);
  }

  /* Scroll indicator */
  .scroll-indicator {
    position: absolute;
    bottom: 3rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .scroll-mouse {
    width: 20px;
    height: 32px;
    border: 1.5px solid var(--glass-border);
    border-radius: 10px;
    display: flex;
    justify-content: center;
    padding-top: 6px;
  }

  .scroll-wheel {
    width: 2px;
    height: 6px;
    background: var(--accent-amber);
    border-radius: 1px;
    animation: scroll-wheel 2s ease-in-out infinite;
  }

  @keyframes scroll-wheel {
    0%, 100% { transform: translateY(0); opacity: 1; }
    50% { transform: translateY(6px); opacity: 0.3; }
  }

  .scroll-text {
    font-family: var(--font-terminal);
    font-size: 0.6rem;
    color: var(--text-dim);
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  /* Responsive */
  @media (max-width: 1100px) {
    .hero--with-note {
      grid-template-columns: minmax(0, 750px);
      align-content: center;
      justify-content: start;
      gap: 4rem;
      padding-bottom: 7rem;
    }

    .hero-latest {
      max-width: 560px;
      justify-self: start;
    }

    .scroll-indicator {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding-top: 6rem;
    }

    .hero--with-note {
      gap: 3rem;
    }

    .hero-identity {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .hero-photo-small {
      width: 80px;
      height: 80px;
    }

    .hero-name {
      font-size: clamp(2rem, 10vw, 3rem);
    }

    .hero-roles {
      justify-content: flex-start;
    }

    .hero-output {
      font-size: 0.75rem;
    }

    .hero-cta {
      flex-direction: column;
    }

    .hero-cta .btn {
      width: 100%;
      justify-content: center;
    }

    .hero-latest {
      padding-left: 0.9rem;
    }

    .latest-note__primary h2 {
      font-size: clamp(1.7rem, 7.2vw, 2.1rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-latest {
      animation: none;
    }

    .latest-note__visual img,
    .latest-note__open svg { transition: none; }
  }
</style>
