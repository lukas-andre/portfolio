<footer class="footer">
  <div class="footer-content">
    <div class="footer-logo">
      <span class="logo-bracket">[</span>
      <span class="logo-text gradient-text">LH</span>
      <span class="logo-bracket">]</span>
    </div>

    <p class="footer-text">
      Built as a <span class="highlight">living system</span> with <span class="highlight-magenta">human judgment</span>
      <span class="separator">|</span>
      Orchestrated with Herdr · Claude · Codex · OMP
      <span class="separator">|</span>
      <span class="year">2026</span>
    </p>

    <nav class="footer-links" aria-label="Explore Lucas Henry">
      <a href="/es/notas/" hreflang="es">Notas en español</a>
      <a href="/en/notes/" hreflang="en">Notes in English</a>
      <a href="https://show.lucashenry.dev/">Show · projects & briefs ↗</a>
    </nav>

    <div class="footer-tech">
      <span class="tech-item">Astro</span>
      <span class="tech-dot">•</span>
      <span class="tech-item">React</span>
      <span class="tech-dot">•</span>
      <span class="tech-item">Framer Motion</span>
      <span class="tech-dot">•</span>
      <span class="tech-item">TypeScript</span>
    </div>
  </div>
</footer>

<style>
  .footer-links { display: flex; flex-wrap: wrap; gap: .6rem 1.5rem; justify-content: center; margin: 1.3rem 0; font: .8rem/1.6 var(--font-terminal); }
  .footer-links a { color: var(--accent-amber); text-decoration: underline; text-underline-offset: .25em; }
  .footer {
    padding: 3rem 5%;
    border-top: 1px solid var(--glass-border);
    text-align: center;
    background: var(--bg-secondary);
  }

  .footer-content {
    max-width: var(--content-width);
    margin: 0 auto;
  }

  .footer-logo {
    font-family: var(--font-terminal);
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.1rem;
  }

  .logo-bracket {
    color: var(--accent-amber);
  }

  .footer-text {
    font-family: var(--font-terminal);
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .highlight {
    color: var(--accent-amber);
  }

  .highlight-magenta {
    color: var(--accent-sage);
  }

  .separator {
    color: var(--bg-tertiary);
  }

  .footer-tech {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tech-item {
    font-family: var(--font-terminal);
    font-size: 0.7rem;
    color: var(--text-muted);
    opacity: 0.6;
  }

  .tech-dot {
    color: var(--accent-amber);
    opacity: 0.3;
  }
</style>
