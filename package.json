{
  "name": "portfolio-lucas-henry",
  "type": "module",
  "version": "2.0.0",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "node server.js",
    "prebuild": "node scripts/notes/validate.mjs --tier release --published-only",
    "build": "astro build",
    "postbuild": "node scripts/notes/prune-dist.mjs",
    "build:drafts": "INCLUDE_DRAFTS=true astro build",
    "postbuild:drafts": "INCLUDE_DRAFTS=true node scripts/notes/prune-dist.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "validate:notes": "node scripts/notes/validate.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run validate:notes && npm run check && npm run test:unit && npm run build",
    "notes:new": "node scripts/notes/new.mjs",
    "notes:context": "node scripts/notes/context.mjs",
    "notes:status": "node scripts/notes/status.mjs",
    "notes:sync-research": "node scripts/notes/sync-research.mjs",
    "notes:validate": "node scripts/notes/validate.mjs",
    "notes:approve-angle": "node scripts/notes/approve-angle.mjs",
    "notes:approve-release": "node scripts/notes/approve-release.mjs",
    "notes:publish": "node scripts/notes/publish.mjs",
    "notes:preview": "node scripts/notes/preview.mjs",
    "notes:smoke": "node scripts/notes/smoke.mjs",
    "notes:metrics": "node scripts/notes/metrics.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^3.1.9",
    "@astrojs/react": "^3.6.0",
    "@astrojs/sitemap": "3.6.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^4.16.0",
    "astro-og-canvas": "^0.7.2",
    "beautiful-mermaid": "^1.1.3",
    "dejavu-fonts-ttf": "^2.37.3",
    "framer-motion": "^11.11.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "satori": "^0.18.3",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "gray-matter": "^4.0.3",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "typescript": "^5.6.0",
    "unified": "^11.0.5"
  }
}
