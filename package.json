    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "satori": "^0.18.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
